Options -MultiViews
AddType application/javascript .js .mjs
AddType text/css .css

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www -> non-www (tracker #14)
  RewriteCond %{HTTP_HOST} ^www\.kayaforyou\.com$ [NC]
  RewriteRule ^(.*)$ https://kayaforyou.com/$1 [R=301,L]

  # Allow assets folder to pass through directly
  RewriteRule ^assets/ - [L]

  # Home page
  RewriteRule ^$ /index.html [L]

  # Prerendered pages (tracker #11) are kept in /_pages:
  # /collection/abhinetri (with or without a trailing slash)
  #   -> /_pages/collection/abhinetri/index.html
  RewriteCond %{DOCUMENT_ROOT}/_pages/$1/index.html -f
  RewriteRule ^(.+?)/?$ /_pages/$1/index.html [L]

  # Skip rewrite for other existing files (sitemap.xml, robots.txt, logo...)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Send everything else to the "Page Not Found" page (status 200 as before;
  # real 404s are tracker #13)
  RewriteRule ^ /404.html [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
